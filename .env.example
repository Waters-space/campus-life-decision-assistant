# Frontend links. VITE_ variables are visible in the browser; never put secrets here.
VITE_PRIMARY_AGENT_URL=https://your-agent.example.com/chat
VITE_USED_BOOK_AGENT_URL=https://your-used-book-agent.example.com/chat

# Local development ports.
WEB_PORT=5174
API_PORT=8788

# Admin registration. Use a long random value and keep it server-side.
ADMIN_INTERNAL_CODE=replace-with-a-long-random-code

# Optional Yuanjing MaaS workflow integration. These values are server-side only.
MAAS_ENABLED=false
MAAS_WORKFLOW_URL=https://maas-api.ai-yuanjing.com/openapi/console/api/yuanjing_workflow/run
MAAS_APP_ID=replace-with-your-workflow-app-id
MAAS_API_KEY=replace-with-your-bearer-token
